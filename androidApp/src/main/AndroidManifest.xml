<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Timers. SCHEDULE_EXACT_ALARM rather than USE_EXACT_ALARM: the second is granted
        automatically and cannot be revoked, and Play restricts it to apps whose core
        function is an alarm clock or a calendar. This is a recipe app. So the user is
        asked once, in settings, and a timer set without it still fires, just not
        necessarily on the minute. Cuisson says so rather than pretending otherwise.
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Cuisson">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Registered for the share sheet only. Cuisson deliberately does not claim
            http links: browsing belongs in the browser, and offering to open every
            link in the world would be presumptuous.
        -->
        <activity
            android:name=".ImportActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:label="Save to Cuisson">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity
            android:name=".CookModeActivity"
            android:exported="false"
            android:label="@string/app_name" />

        <!-- Where a timer reaching zero lands, with Cuisson closed. -->
        <receiver
            android:name=".TimerAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.cuisson.TIMER" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
