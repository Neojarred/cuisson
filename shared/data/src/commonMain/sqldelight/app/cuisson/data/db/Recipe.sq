-- Raw text is never discarded. Every table that holds parsed data also holds the text it
-- was parsed from, so a better parser can be run over the library later. See adr/0004.

CREATE TABLE recipe (
    id                  TEXT    NOT NULL PRIMARY KEY,
    title               TEXT    NOT NULL,
    -- The title as the source wrote it, kept so a bad tidy is reversible. ADR-0004.
    title_raw           TEXT,
    source_kind         TEXT    NOT NULL,
    source_url          TEXT,
    source_name         TEXT,
    servings_count      REAL,
    servings_unit       TEXT,
    prep_minutes        INTEGER,
    cook_minutes        INTEGER,
    total_minutes       INTEGER,
    notes               TEXT,
    -- A path inside the app's own storage. Never a remote address: images are copied
    -- to the device so the recipe works offline, per ADR-0007.
    image_path          TEXT,
    -- The Chapter this recipe is filed in. Every Cookbook has a default Chapter, so a
    -- recipe nobody has filed still has one: the default Chapter of Unfiled.
    chapter_id          TEXT,
    language            TEXT    NOT NULL DEFAULT 'en',
    extraction_tier     TEXT    NOT NULL,
    extraction_conf     REAL    NOT NULL DEFAULT 0.0,
    needs_review        INTEGER NOT NULL DEFAULT 0,
    created_at          INTEGER NOT NULL,
    updated_at          INTEGER NOT NULL
);

-- A second import of an address we already hold should offer the recipe we have rather
-- than duplicating it silently.
CREATE INDEX recipe_source_url ON recipe(source_url);

CREATE TABLE ingredient_line (
    id                  TEXT    NOT NULL PRIMARY KEY,
    recipe_id           TEXT    NOT NULL REFERENCES recipe(id) ON DELETE CASCADE,
    position            INTEGER NOT NULL,
    raw_text            TEXT    NOT NULL,
    group_label         TEXT,
    quantity_min        REAL,
    quantity_max        REAL,
    unit_canonical      TEXT,
    unit_system         TEXT,
    unit_alt_canonical  TEXT,
    unit_alt_system     TEXT,
    item_text           TEXT,
    preparation         TEXT,
    optional            INTEGER NOT NULL DEFAULT 0,
    canonical_item_id   TEXT,
    parse_confidence    REAL    NOT NULL DEFAULT 0.0
);

CREATE INDEX ingredient_line_recipe ON ingredient_line(recipe_id, position);

CREATE TABLE step (
    id                  TEXT    NOT NULL PRIMARY KEY,
    recipe_id           TEXT    NOT NULL REFERENCES recipe(id) ON DELETE CASCADE,
    position            INTEGER NOT NULL,
    text                TEXT    NOT NULL,
    duration_seconds    INTEGER,
    -- Pointers the source made to material we did not capture, such as "see Note 3".
    unresolved_refs     TEXT
);

CREATE INDEX step_recipe ON step(recipe_id, position);

-- The publisher's own notes, kept as they wrote them. Never shared. See ADR-0009.
CREATE TABLE source_note (
    id                  TEXT    NOT NULL PRIMARY KEY,
    recipe_id           TEXT    NOT NULL REFERENCES recipe(id) ON DELETE CASCADE,
    position            INTEGER NOT NULL,
    label               TEXT,
    text                TEXT    NOT NULL
);

CREATE INDEX source_note_recipe ON source_note(recipe_id, position);

insertRecipe:
INSERT OR REPLACE INTO recipe(
    id, title, title_raw, source_kind, source_url, source_name,
    servings_count, servings_unit, prep_minutes, cook_minutes, total_minutes,
    notes, image_path, chapter_id, language, extraction_tier, extraction_conf,
    needs_review, created_at, updated_at
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

setImagePath:
UPDATE recipe SET image_path = ? WHERE id = ?;

insertIngredientLine:
INSERT OR REPLACE INTO ingredient_line(
    id, recipe_id, position, raw_text, group_label,
    quantity_min, quantity_max, unit_canonical, unit_system,
    unit_alt_canonical, unit_alt_system, item_text, preparation,
    optional, canonical_item_id, parse_confidence
) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

insertStep:
INSERT OR REPLACE INTO step(id, recipe_id, position, text, duration_seconds, unresolved_refs)
VALUES (?, ?, ?, ?, ?, ?);

selectAllRecipes:
SELECT * FROM recipe ORDER BY updated_at DESC;

selectRecipeById:
SELECT * FROM recipe WHERE id = ?;

selectIngredientsForRecipe:
SELECT * FROM ingredient_line WHERE recipe_id = ? ORDER BY position;

setStepDuration:
UPDATE step SET duration_seconds = ? WHERE id = ?;

selectAllSteps:
SELECT id, text FROM step;

stepsWithoutDuration:
SELECT id, text FROM step WHERE duration_seconds IS NULL;

selectStepsForRecipe:
SELECT * FROM step WHERE recipe_id = ? ORDER BY position;

-- One tap at the end of Cook Mode. See 5.sqm.
CREATE TABLE cook_entry (
    id                  TEXT    NOT NULL PRIMARY KEY,
    recipe_id           TEXT    NOT NULL REFERENCES recipe(id) ON DELETE CASCADE,
    cooked_at           INTEGER NOT NULL,
    rating              INTEGER,
    note                TEXT
);

CREATE INDEX cook_entry_recipe ON cook_entry(recipe_id, cooked_at);

insertCookEntry:
INSERT INTO cook_entry(id, recipe_id, cooked_at, rating, note) VALUES (?, ?, ?, ?, ?);

cookEntriesFor:
SELECT * FROM cook_entry WHERE recipe_id = ? ORDER BY cooked_at DESC;

-- Cookbooks and Chapters. See 4.sqm for why every cookbook has a default chapter.
CREATE TABLE cookbook (
    id                  TEXT    NOT NULL PRIMARY KEY,
    name                TEXT    NOT NULL,
    position            INTEGER NOT NULL,
    created_at          INTEGER NOT NULL
);

CREATE TABLE chapter (
    id                  TEXT    NOT NULL PRIMARY KEY,
    cookbook_id         TEXT    NOT NULL REFERENCES cookbook(id) ON DELETE CASCADE,
    name                TEXT    NOT NULL,
    position            INTEGER NOT NULL
);

CREATE INDEX chapter_cookbook ON chapter(cookbook_id, position);
CREATE INDEX recipe_chapter ON recipe(chapter_id);

insertCookbook:
INSERT INTO cookbook(id, name, position, created_at) VALUES (?, ?, ?, ?);

insertChapter:
INSERT INTO chapter(id, cookbook_id, name, position) VALUES (?, ?, ?, ?);

renameCookbook:
UPDATE cookbook SET name = ? WHERE id = ?;

deleteCookbook:
DELETE FROM cookbook WHERE id = ? AND id != 'unfiled';

selectCookbooks:
SELECT cookbook.*, count(recipe.id) AS recipes
FROM cookbook
LEFT JOIN chapter ON chapter.cookbook_id = cookbook.id
LEFT JOIN recipe ON recipe.chapter_id = chapter.id
GROUP BY cookbook.id
ORDER BY cookbook.position, cookbook.created_at;

selectChapters:
SELECT * FROM chapter WHERE cookbook_id = ? ORDER BY position;

fileRecipe:
UPDATE recipe SET chapter_id = ?, updated_at = ? WHERE id = ?;

defaultChapterOf:
SELECT id FROM chapter WHERE cookbook_id = ? ORDER BY position LIMIT 1;

-- Search. FTS4, not FTS5: Android's SQLite has no fts5 module. Diacritics are folded by
-- unicode61, so "creme" finds "crème". See 3.sqm.
CREATE VIRTUAL TABLE recipe_search USING fts4(
    title,
    ingredients,
    notes,
    recipe_id,
    notindexed=recipe_id,
    tokenize=unicode61
);

insertSearchRow:
INSERT INTO recipe_search(title, ingredients, notes, recipe_id) VALUES (?, ?, ?, ?);

deleteSearchRow:
DELETE FROM recipe_search WHERE recipe_id = ?;

countSearchRows:
SELECT count(*) FROM recipe_search;

-- No ORDER BY rank: that is an FTS5 column and this is FTS4.
searchRecipes:
SELECT recipe_id FROM recipe_search WHERE recipe_search MATCH ?;

insertSourceNote:
INSERT OR REPLACE INTO source_note(id, recipe_id, position, label, text)
VALUES (?, ?, ?, ?, ?);

selectNotesForRecipe:
SELECT * FROM source_note WHERE recipe_id = ? ORDER BY position;

selectSources:
SELECT id, title, source_url FROM recipe WHERE source_url IS NOT NULL;

countRecipes:
SELECT count(*) FROM recipe;
